{
  "KSampler": {
    "display_name": "KSampler",
    "category": "sampling",
    "python_module": "nodes",
    "input": {
      "required": {
        "seed": ["INT", { "default": 0, "min": 0, "max": 999999999, "step": 1 }],
        "steps": ["INT", { "default": 20, "min": 1, "max": 100, "step": 1 }],
        "cfg": ["FLOAT", { "default": 7, "min": 0, "max": 20, "step": 0.1 }],
        "model": ["MODEL"],
        "positive": ["CONDITIONING"]
      }
    },
    "input_order": { "required": ["seed", "steps", "cfg", "model", "positive"] },
    "output": ["LATENT"],
    "output_name": ["LATENT"],
    "output_node": false
  },
  "CheckpointLoaderSimple": {
    "display_name": "加载检查点",
    "category": "loaders",
    "python_module": "nodes",
    "input": {
      "required": {
        "ckpt_name": [["model.safetensors", "other.safetensors"]]
      }
    },
    "output": ["MODEL", "CLIP", "VAE"],
    "output_name": ["MODEL", "CLIP", "VAE"],
    "output_node": false
  },
  "CLIPTextEncode": {
    "display_name": "提示词编码",
    "category": "conditioning",
    "python_module": "nodes",
    "input": {
      "required": {
        "text": ["STRING", { "multiline": true }],
        "clip": ["CLIP"]
      }
    },
    "output": ["CONDITIONING"],
    "output_name": ["CONDITIONING"],
    "output_node": false
  },
  "SaveImage": {
    "display_name": "保存图像",
    "category": "image",
    "python_module": "nodes",
    "input": {
      "required": {
        "filename_prefix": ["STRING", { "default": "ComfyUI" }],
        "images": ["IMAGE"]
      }
    },
    "output": [],
    "output_name": [],
    "output_node": true
  }
}
